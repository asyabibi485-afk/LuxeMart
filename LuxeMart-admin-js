const C=window.LUXEMART_CONFIG||{};const sb=(C.SUPABASE_URL?.startsWith("http")&&C.SUPABASE_ANON_KEY)?supabase.createClient(C.SUPABASE_URL,C.SUPABASE_ANON_KEY):null;const $=id=>document.getElementById(id);function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
async function boot(){if(!sb){$("loginMsg").textContent="Add Supabase settings to config.js first.";return}let {data:{session}}=await sb.auth.getSession();show(session);sb.auth.onAuthStateChange((_e,s)=>show(s))}
async function show(session){$("login").classList.toggle("hidden",!!session);$("dashboard").classList.toggle("hidden",!session);if(session){await loadProducts();await loadOrders()}}
$("loginForm").onsubmit=async e=>{e.preventDefault();let {error}=await sb.auth.signInWithPassword({email:$("email").value,password:$("password").value});$("loginMsg").textContent=error?error.message:""}
$("logout").onclick=()=>sb.auth.signOut();
$("productForm").onsubmit=async e=>{e.preventDefault();let f=new FormData(e.target);let {error}=await sb.from("products").insert({name:f.get("name"),price:Number(f.get("price")),category:f.get("category"),description:f.get("description"),image_url:f.get("image_url"),active:true});if(error){alert(error.message);return}e.target.reset();loadProducts()}
async function loadProducts(){let {data,error}=await sb.from("products").select("*").order("created_at",{ascending:false});if(error)return alert(error.message);$("productRows").innerHTML=(data||[]).map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.category)}</td><td>Rs ${Number(p.price).toLocaleString()}</td><td><button class="danger" onclick="delProduct('${p.id}')">Delete</button></td></tr>`).join("")}
window.delProduct=async id=>{if(!confirm("Delete this product?"))return;let {error}=await sb.from("products").delete().eq("id",id);if(error)alert(error.message);else loadProducts()}
async function loadOrders(){let {data,error}=await sb.from("orders").select("*").order("created_at",{ascending:false});if(error)return alert(error.message);$("orderRows").innerHTML=(data||[]).map(o=>`<tr><td>${esc(String(o.id).slice(0,8))}</td><td>${esc(o.customer_name)}<br>${esc(o.phone)}</td><td>Rs ${Number(o.total).toLocaleString()}</td><td><select class="status" onchange="status('${o.id}',this.value)">${["pending","confirmed","shipped","delivered","cancelled"].map(s=>`<option ${o.status===s?"selected":""}>${s}</option>`).join("")}</select></td><td>${new Date(o.created_at).toLocaleString()}</td></tr>`).join("")}
window.status=async(id,value)=>{let {error}=await sb.from("orders").update({status:value}).eq("id",id);if(error)alert(error.message)}
boot();